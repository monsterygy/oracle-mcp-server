# ================================================================
# Oracle Database MCP Server — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# All variables below are read at startup by src/config.ts.

# --- Oracle Connection (required) ---
# Provide exactly one of the three connection string formats below.

# Method 1: EZ Connect (simplest)
# Format: host:port/service_name
ORACLE_USER=hr
ORACLE_PASSWORD=your_password
ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1

# Method 2: TNS Alias (requires tnsnames.ora)
# ORACLE_CONNECT_STRING=ORCLPDB1
# TNS_ADMIN=/path/to/your/oracle/network/admin

# Method 3: Full TNS Descriptor (no tnsnames.ora needed)
# ORACLE_CONNECT_STRING=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCLPDB1)))

# --- Default Schema (optional) ---
# Lock all connections to a specific schema.
# Uses ALTER SESSION SET CURRENT_SCHEMA under the hood.
# When set, SQL like SELECT * FROM users will resolve to <SCHEMA>.users
# without needing to prefix the schema name every time.
# ORACLE_SCHEMA=BLCU_CAREER

# --- Oracle Home (optional, fallback for tnsnames.ora search) ---
# ORACLE_HOME=/opt/oracle/product/21c/dbhome

# --- Driver Mode (optional) ---
# oracledb 6.x defaults to "thin" mode (pure JavaScript, no Oracle Client needed).
# To use "thick" mode (for Oracle 11g or advanced features), set this to the
# path of your Oracle Instant Client library directory:
# ORACLE_CLIENT_DIR=/opt/oracle/instantclient_19_22

# --- Connection Pool (optional) ---
# DB_POOL_MIN=2              # Minimum connections to keep open
# DB_POOL_MAX=10             # Maximum connections
# DB_POOL_INCREMENT=1        # Connections to add when pool exhausted
# DB_POOL_TIMEOUT=30         # Seconds before idle connections close
# DB_POOL_PING_INTERVAL=60   # Seconds between pool connection pings
# DB_POOL_CONNECT_TIMEOUT_MS=5000  # ms to wait for a connection from pool

# --- Query Safety Limits (optional) ---
# QUERY_MAX_ROWS=500         # Max rows returned by db_query (hard cap)
# QUERY_TIMEOUT_MS=10000     # Query timeout in milliseconds
# SQL_MAX_LENGTH=5000        # Max SQL string length (chars)
# WHERE_MAX_LENGTH=2000      # Max WHERE clause length (chars)
# DML_MAX_ROWS=1000          # Max rows DML can affect (safety cap)

# --- Rate Limiting (optional) ---
# RATE_LIMIT_ENABLED=true    # Enable per-minute request limiting
# RATE_LIMIT_PER_MINUTE=60   # Max requests per minute

# --- Table Access Control (optional) ---
# ALLOWED_TABLES=USERS,ORDERS,PRODUCTS    # Whitelist (comma-separated, uppercase)
# BLOCKED_TABLES=SECRET_CONFIG,AUDIT_LOG  # Blacklist (comma-separated, uppercase)
# READ_ONLY_MODE=false       # If true, all DML (INSERT/UPDATE/DELETE) is blocked

# --- Logging (optional) ---
# LOG_LEVEL=INFO              # DEBUG | INFO | WARN | ERROR | NONE
# LOG_JSON=false              # If true, output JSON-structured logs

# ================================================================
# WorkBuddy MCP Configuration (~/.workbuddy/mcp.json)
# ================================================================
# After setting up .env, add this to your MCP config:
#
# {
#   "mcpServers": {
#     "oracle-db": {
#       "command": "node",
#       "args": ["/path/to/database-mcp-server/dist/index.js"],
#       "env": {
#         "ORACLE_USER": "hr",
#         "ORACLE_PASSWORD": "your_password",
#         "ORACLE_CONNECT_STRING": "localhost:1521/ORCLPDB1",
#         "LOG_LEVEL": "INFO",
#         "DML_MAX_ROWS": "1000",
#         "READ_ONLY_MODE": "false"
#       }
#     }
#   }
# }
#
# Then open the connector management page and click "Trust" to enable.
